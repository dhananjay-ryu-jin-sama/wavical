{
  "name": "wavical",
  "version": "1.2.1",
  "description": "A lightweight, security-first, AI-native desktop app framework built in Rust using OS WebView2, capability-gated IPC, optional sandboxed Node.js backends, and signed auto-updates.",
  "bin": {
    "wavical": "bin/wavical.js",
    "wca": "bin/wavical.js"
  },
  "files": [
    "bin/wavical.js",
    "bin/wavical.exe",
    "bin/wavical-shell.exe",
    "bin/wavical-shell-dev.exe",
    "bin/checksums.txt",
    "README.md",
    "CHANGELOG.md",
    "LICENSE*"
  ],
  "scripts": {
    "test": "cargo test --workspace && node --test scripts/scripts.test.js",
    "build:release": "cargo build --release --locked -p wavical-cli --bin wavical && cargo build --release --locked -p wavical-shell --bin wavical-shell && cargo build --release --locked -p wavical-shell --bin wavical-shell-dev --features dev-shell --target-dir target/dev-shell",
    "sync:version": "node scripts/sync-version.js",
    "verify:package": "node scripts/verify-package.js",
    "prepack": "node scripts/prepack.js",
    "prepublishOnly": "node scripts/verify-package.js --strict --verify-checksums-only"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhananjay-ryu-jin-sama/Wavical.git"
  },
  "keywords": [
    "wavical",
    "desktop",
    "webview",
    "webview2",
    "rust",
    "security",
    "ai",
    "rag",
    "gguf",
    "nodejs",
    "framework",
    "cli"
  ],
  "author": "",
  "license": "MIT OR Apache-2.0",
  "type": "commonjs",
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "engines": {
    "node": ">=14.8.0"
  },
  "bugs": {
    "url": "https://github.com/dhananjay-ryu-jin-sama/Wavical/issues"
  },
  "homepage": "https://github.com/dhananjay-ryu-jin-sama/Wavical#readme"
}
